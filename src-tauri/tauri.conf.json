{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZK-Note",
  "version": "../package.json",
  "identifier": "dev.zerokoo.zk-note",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "ZK-Note",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss: https:; img-src 'self' data: https: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMkYxQTBDM0E0OTZGNzUKUldSMWIwazZEQm92bW00clpvcHYvYmlrc3RuM09rTlA2S25RRElNOE5qMVJQN0IzU1IwT3Fqa28K",
      "endpoints": [
        "https://github.com/zero-koo/zk-note/releases/latest/download/latest.json"
      ]
    }
  }
}
