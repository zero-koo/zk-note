# Copy to .env.local and fill in — `npx convex dev` writes CONVEX_DEPLOYMENT
# and the dashboard shows the deployment URL.

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Convex deployment URL, read by the app at build time (src/lib/convex.tsx).
# The app renders a visible error instead of starting when this is missing.
VITE_CONVEX_URL=
